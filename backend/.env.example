# Copy to backend/.env and fill in. backend/.env is gitignored: never commit real values.
# The backend reads it from the backend/ working directory (spring.config.import in application.properties).

# SQL Server login for SportCenterDB on localhost:1433
DB_USERNAME=sa
DB_PASSWORD=change-me

# Base64-encoded HMAC key, at least 32 bytes after decoding. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Any long random string; signs the demo mock gateway callbacks.
PAYMENT_CALLBACK_SECRET=

# The mock gateway works only with a demo/dev/test profile.
spring.profiles.active=demo
PAYMENT_MOCK_GATEWAY_ENABLED=true

# Online payments: "mock" (simulator, no VNPay account needed) or "vnpay" (VNPay sandbox).
PAYMENT_PROVIDER=mock
# Required only when PAYMENT_PROVIDER=vnpay. Get the sandbox TMN code and hash secret from the
# team privately (or register at https://sandbox.vnpayment.vn); do not put them in Git.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

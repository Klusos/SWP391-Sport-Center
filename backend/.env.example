# Copy to backend/.env. Never put real credentials in Git.
# The local database defaults to SportCenterDemo. Override with a process environment
# variable or Spring launch argument when using a different target.

# Required local SQL Server credentials
DB_USERNAME=
DB_PASSWORD=

# Required Base64-encoded HMAC key (at least 32 bytes after decoding)
JWT_SECRET=

# Required only when the mock payment callback is explicitly enabled
PAYMENT_CALLBACK_SECRET=

# Required only when the VNPay provider is selected
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
